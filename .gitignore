/target

# Personal, per-developer Claude Code permission overrides -- never
# meant to be shared/committed (unlike .claude/settings.json, which
# would be team-wide).
.claude/settings.local.json

# zhao's own run-metadata.json output. Written under any project dir's
# target/zhao/, including inside test fixtures' checked-in target/
# directories (those hold real, tracked manifest.json fixtures, so this
# can't just be a blanket */target/ ignore) -- every zhao check/zhao diff
# run writes one, including test runs against fixture projects.
**/target/zhao/

# examples/hello-zhao-addon/ is its own separate Cargo workspace (see its
# own README's "Why this isn't a workspace member") -- its build output
# needs its own ignore entry since the /target rule above only anchors to
# the repo root.
examples/hello-zhao-addon/target
